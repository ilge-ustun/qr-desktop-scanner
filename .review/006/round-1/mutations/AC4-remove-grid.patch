 /* The warning screenshot and the live ready popover share one grid cell, one
    held left and one right, so they overlap inside the column at every width
    and never leave it. The popover comes last, so it is painted in front. */
-.shots { flex: 1 1 380px; min-width: 0; max-width: 480px; margin-inline: auto; display: grid; padding-block: 10px 20px; }
+.shots { flex: 1 1 380px; min-width: 0; max-width: 480px; margin-inline: auto; padding-block: 10px 20px; }
 .shots > * { grid-area: 1 / 1; width: 72%; }
 .shots > :first-child { justify-self: start; transform: rotate(-3deg); }
 .shots > :last-child { justify-self: end; margin-top: 22%; transform: rotate(4deg); }
